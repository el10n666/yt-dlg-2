{
  "name": "yt-dlg-2",
  "version": "0.1.1",
  "description": "Простой скачиватель видео и аудио",
  "main": "main.js",
  "private": true,
  "scripts": {
    "test": "node --test",
    "fetch-bin": "node scripts/fetch-binaries.js",
    "release": "npm run fetch-bin && npm test && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.el10n666.yt-dlg-2",
    "productName": "Скачать видео",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "yt-dlg-2-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Скачать видео"
    },
    "publish": {
      "provider": "github",
      "owner": "el10n666",
      "repo": "yt-dlg-2",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
